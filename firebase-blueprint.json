{
  "entities": {
    "settings": {
      "title": "System Settings",
      "description": "Global settings including society background, timer, and portal options",
      "type": "object",
      "properties": {
        "backgroundImage": { "type": "string" },
        "sigilImage": { "type": "string" },
        "timerMinutes": { "type": "number" },
        "heading": { "type": "string" },
        "subheading": { "type": "string" },
        "adminPin": { "type": "string" },
        "passingScore": { "type": "number" }
      }
    },
    "questions": {
      "title": "Application Question",
      "description": "Customizable questionnaire item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["agree_disagree", "multiple_choice", "text", "scale", "photo"] },
        "target": { "type": "string", "enum": ["candidate", "member", "both"] },
        "allowMemberAddInfo": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctOptionIndex": { "type": "number" },
        "points": { "type": "number" },
        "order": { "type": "number" },
        "required": { "type": "boolean" }
      },
      "required": ["title", "type", "order"]
    },
    "members": {
      "title": "Member Account",
      "description": "Authorized member credentials with alias and custom password",
      "type": "object",
      "properties": {
        "alias": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["alias", "password", "isActive"]
    },
    "submissions": {
      "title": "Candidate Submission",
      "description": "Final answersheet submitted by an applicant",
      "type": "object",
      "properties": {
        "candidateName": { "type": "string" },
        "candidateAlias": { "type": "string" },
        "candidateEmail": { "type": "string" },
        "submittedAt": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "answers": { "type": "object" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "accepted", "scrutiny", "rejected"] }
      },
      "required": ["candidateName", "submittedAt", "answers"]
    },
    "member_info_entries": {
      "title": "Member Info Entry",
      "description": "Information and text intelligence submitted by members for a specific question anytime",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "questionTitle": { "type": "string" },
        "memberAlias": { "type": "string" },
        "memberName": { "type": "string" },
        "content": { "type": "string" },
        "submittedAt": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["questionId", "memberAlias", "content", "submittedAt"]
    },
    "task_forms": {
      "title": "Member Task Form",
      "description": "Task questionnaires for members in the /#/info task portal, completely separate from candidate test",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "required": { "type": "boolean" },
              "allowAddInfo": { "type": "boolean" }
            },
            "required": ["id", "label", "type"]
          }
        }
      },
      "required": ["title", "questions"]
    },
    "task_submissions": {
      "title": "Task Submission",
      "description": "Form submissions by members for distinct purposes with continuous information updates",
      "type": "object",
      "properties": {
        "formId": { "type": "string" },
        "formTitle": { "type": "string" },
        "memberAlias": { "type": "string" },
        "memberName": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "answers": { "type": "object" },
        "infoUpdates": { "type": "array" }
      },
      "required": ["formId", "memberAlias", "purpose", "answers", "createdAt"]
    },
    "knowledge_articles": {
      "title": "Knowledge Article",
      "description": "Council knowledge archive articles with formatted HTML content, uploaded images, and category metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "authorAlias": { "type": "string" },
        "authorName": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "order": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "content", "category"]
    },
    "member_notifications": {
      "title": "Member Notification",
      "description": "Council written and 1:1 image notifications dispatched to all or selected members",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "noticeType": { "type": "string", "enum": ["text", "image"] },
        "imageUrl": { "type": "string" },
        "imageAspectRatio": { "type": "string" },
        "targetType": { "type": "string", "enum": ["all", "specific"] },
        "targetMemberAliases": { "type": "array", "items": { "type": "string" } },
        "acknowledgedBy": { "type": "array", "items": { "type": "string" } },
        "urgency": { "type": "string", "enum": ["standard", "urgent"] },
        "createdAt": { "type": "string" },
        "senderName": { "type": "string" }
      },
      "required": ["title", "targetType", "createdAt"]
    },
    "council_videos": {
      "title": "Council Video Archive",
      "description": "Uploaded YouTube video links with description texts and categories for the member video collection portal (/#/videos)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "youtubeVideoId": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "uploadedByAlias": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "youtubeUrl", "youtubeVideoId", "description", "createdAt"]
    }
  }
}
